{
  "manifest_version": 3,
  "name": "AutoApply",
  "version": "1.0.0",
  "description": "Fill job applications in your own browser from your local AutoApply profile. You press Submit.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8742/*", "http://localhost:8742/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "AutoApply",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.joinhandshake.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.icims.com/*"
      ],
      "js": ["extract.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}

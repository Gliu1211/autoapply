# Required for written answers, resume reading, job scoring and reply sorting.
ANTHROPIC_API_KEY=

# Claude model. One model for everything by default; you can point scoring at a cheaper one.
AUTOAPPLY_MODEL=claude-opus-5-5
# AUTOAPPLY_MODEL_SCORING=claude-haiku-5-5
# AUTOAPPLY_MODEL_ANSWERS=claude-opus-5-5

# Gmail (optional here; you can also connect it in Settings). Needs a Google app password, not your normal password.
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=

# Password AutoApply uses when it creates Workday candidate accounts. Generated and shown in Settings if blank.
# ACCOUNT_PASSWORD=

# Browser: chrome (your installed Chrome, separate profile), msedge, or chromium.
# BROWSER_CHANNEL=chrome
# Attach to a Chrome you started with --remote-debugging-port=9222 --user-data-dir=<some folder> instead:
# BROWSER_CDP_URL=http://127.0.0.1:9222

# AUTOAPPLY_PORT=8742
